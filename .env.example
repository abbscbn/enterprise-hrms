DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1
DB_USER=HR_CORE
DB_PASSWORD=

# Docker backend connects to the EXISTING Oracle container through the host.
DB_HOST_DOCKER=host.docker.internal
RABBITMQ_USER=hrms_dev
RABBITMQ_PASSWORD=
# Enable only AFTER V0004 has SUCCESS history and metadata MATCH.
HRMS_OUTBOX_ENABLED=0
# Enable only AFTER deploy_rules.py confirms matching VALID specification/body.
HRMS_PLSQL_ENABLED=0
# Enable AFTER ENTERPRISE_V2 deployment confirms V0005-V0013 and HRMS_ENTERPRISE.
HRMS_ENTERPRISE_ENABLED=0
# Local HTTP only. Production MUST use HTTPS + HRMS_COOKIE_SECURE=1.
HRMS_ENV=development
HRMS_COOKIE_SECURE=0
HRMS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Host deployment: choose a private writable directory. Compose overrides this path.
HRMS_STORAGE_ROOT=/var/lib/hrms-files
